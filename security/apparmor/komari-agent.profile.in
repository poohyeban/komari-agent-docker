#include <tunables/global>

profile @PROFILE_NAME@ flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability net_raw,
  file,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (receive) peer=dockerd,
  signal (send,receive) peer=@PROFILE_NAME@,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  # The host procfs bind is read-only at the VFS layer; keep an AppArmor
  # write/lock/execute denial as defense in depth, and hide top-level kernel
  # internals that a metrics-only agent does not need.
  deny /host/proc/** wklx,
  deny /host/proc/{kcore,keys,key-users,kallsyms,kpagecgroup,kpagecount,kpageflags,modules,vmcore,sysrq-trigger,iomem,ioports,interrupts,timer_list,sched_debug,slabinfo} r,

  # Komari may enumerate numeric entries for process count, but must not
  # inspect any host process file or process-root symlink.
  # Only net/** (connection/interface metrics) and mountinfo (disk discovery) remain readable.
  deny /host/proc/[0-9]*/{[^nm]*,n[^e]*,ne[^t]*,net?*,m[^o]*,mo[^u]*,mou[^n]*,moun[^t]*,mount[^i]*,mounti[^n]*,mountin[^f]*,mountinf[^o]*,mountinfo?*} r,
  deny /host/proc/[0-9]*/{[^nm]*,n[^e]*,ne[^t]*,net?*,m[^o]*,mo[^u]*,mou[^n]*,moun[^t]*,mount[^i]*,mounti[^n]*,mountin[^f]*,mountinf[^o]*,mountinfo?*}/** r,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # Remote command execution is disabled in config. Deny PTY allocation as a
  # second, kernel-enforced barrier against the interactive terminal path while
  # retaining /bin/sh for Komari's read-only MOTD/basic-info collection.
  deny /dev/ptmx rw,
  deny /dev/pts/** rw,
}
